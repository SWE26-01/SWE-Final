{
  "$defs": {
    "Step": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "agent the Runner talks to",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Agent",
          "type": "string"
        },
        "say": {
          "description": "what the user says to that agent, as in a chat",
          "maxLength": 500,
          "minLength": 1,
          "title": "Say",
          "type": "string"
        },
        "setup": {
          "default": false,
          "description": "prepares the home for the scenario (said to the device owner)",
          "title": "Setup",
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "say"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "expect": {
      "description": "device states expected afterwards, for dashboards to compare; not enforced",
      "patternProperties": {
        "^[a-z_]+\\.[a-z0-9_]+$": {
          "type": "string"
        }
      },
      "title": "Expect",
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "steps"
  ],
  "title": "Scenario",
  "type": "object"
}
