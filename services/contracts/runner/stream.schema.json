{
  "$defs": {
    "Run": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "scenario id; null for free text",
          "title": "Scenario"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "running"
        },
        "started_at": {
          "description": "agent events (Collector) from this time on belong to the run",
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepState"
          },
          "title": "Steps",
          "type": "array"
        },
        "expect": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "device states the scenario expects afterwards",
          "title": "Expect",
          "type": "object"
        }
      },
      "required": [
        "id",
        "scenario",
        "title",
        "started_at",
        "steps"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "running",
        "done",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RunUpdated": {
      "description": "Sent after every change of a run.",
      "properties": {
        "type": {
          "const": "run.updated",
          "default": "run.updated",
          "title": "Type",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/Run"
        }
      },
      "required": [
        "run"
      ],
      "title": "RunUpdated",
      "type": "object"
    },
    "RunsSnapshot": {
      "description": "Sent first on connect: recent runs, newest first (the running one, if any, is first).",
      "properties": {
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Type",
          "type": "string"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/Run"
          },
          "title": "Runs",
          "type": "array"
        }
      },
      "required": [
        "runs"
      ],
      "title": "RunsSnapshot",
      "type": "object"
    },
    "StepState": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "say": {
          "description": "what was said to the agent",
          "title": "Say",
          "type": "string"
        },
        "setup": {
          "description": "prepares the home for the scenario",
          "title": "Setup",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "pending"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the agent's LLM answer (final text)",
          "title": "Reply"
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM tokens the step used, if reported",
          "title": "Tokens"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why the step got no reply",
          "title": "Error"
        }
      },
      "required": [
        "agent",
        "say",
        "setup"
      ],
      "title": "StepState",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "run.updated": "#/$defs/RunUpdated",
      "snapshot": "#/$defs/RunsSnapshot"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RunsSnapshot"
    },
    {
      "$ref": "#/$defs/RunUpdated"
    }
  ]
}
