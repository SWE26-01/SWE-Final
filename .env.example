# scripts/setup.sh copies this to .env (or adds the keys an older .env lacks), fills every
# change-me-* with a random token and HA_TOKEN/HA_ADMIN_PASSWORD automatically.

# Callers of the Device Gateway and Event Collector (services/config/agents.yaml)
AMBIENT_TOKEN_HOME=change-me-home
DASHBOARD_TOKEN=change-me-dashboard

# Home Assistant (filled by setup.sh on a fresh HA)
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_ADMIN_PASSWORD=
