# scripts/setup.sh copies this to .env and fills every change-me-* with a random token
# and HA_TOKEN/HA_ADMIN_PASSWORD automatically. You only add OPENROUTER_API_KEY.

# LLM via OpenRouter — pick a model that supports tool calling (avoid openrouter/auto)
OPENROUTER_API_KEY=
AMBIENT_MODEL=openrouter/anthropic/claude-haiku-5.5

# Ambient-A2A bearer token per agent (who is calling)
AMBIENT_TOKEN_DESKTOP=change-me-desktop
AMBIENT_TOKEN_SMARTPHONE=change-me-smartphone
AMBIENT_TOKEN_ORCHESTRATOR=change-me-orchestrator
AMBIENT_TOKEN_ROOM1=change-me-room1
AMBIENT_TOKEN_ROOM2=change-me-room2
AMBIENT_TOKEN_PROBE=change-me-probe

# OpenClaw gateways (local Control UI / CLI auth)
OPENCLAW_GATEWAY_TOKEN=change-me-gateway

# Optional services (SWE-Final services/). Leave empty to talk to Home Assistant directly.
AMBIENT_GATEWAY_URL=
AMBIENT_COLLECTOR_URL=

# Home Assistant (filled by setup.sh on a fresh HA)
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_ADMIN_PASSWORD=

# Dashboards read device states (services/ Gateway) and events (Collector) with this token.
DASHBOARD_TOKEN=change-me-dashboard

# Live Simulation (services/ Runner): may ask agents to say things; commands no devices.
SIMULATOR_TOKEN=change-me-simulator

# Agent Hub and Studio (services/): the home user's token for the Studio and Hub screens (create,
# connect, disconnect agents), Studio's token for registering agents in the Hub, and PostgreSQL.
HOME_USER_TOKEN=change-me-home-user
STUDIO_TOKEN=change-me-studio
POSTGRES_PASSWORD=change-me-postgres
# Studio fills its agent form with an LLM through LangChain (OPENROUTER_API_KEY above).
# STUDIO_LLM=rules uses the offline keyword filler instead (no key, no cost).
STUDIO_LLM=
STUDIO_MODEL=anthropic/claude-haiku-5.5
