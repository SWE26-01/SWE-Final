# cp .env.example .env  — then fill in. Generate tokens with: openssl rand -hex 24
# Ambient-A2A bearer token per agent (who is calling)
AMBIENT_TOKEN_DESKTOP=change-me-desktop
AMBIENT_TOKEN_SMARTPHONE=change-me-smartphone
AMBIENT_TOKEN_ORCHESTRATOR=change-me-orchestrator
AMBIENT_TOKEN_ROOM1=change-me-room1
AMBIENT_TOKEN_ROOM2=change-me-room2
AMBIENT_TOKEN_PROBE=change-me-probe
# Home Assistant: Profile → Security → Long-lived access tokens
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
# OpenClaw gateways (local control UI/CLI auth) and model
OPENCLAW_GATEWAY_TOKEN=change-me-gateway
AMBIENT_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
