# scripts/setup.sh copies this to .env and fills every change-me-* with a random token.
# You only add OPENROUTER_API_KEY. Then: docker compose up -d --build (or scripts/run_all.sh).

# LLM via OpenRouter: the agents and Studio call Claude Haiku (instead of per-agent SLMs).
# Pick a model that supports tool calling (avoid openrouter/auto).
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/anthropic/claude-haiku-5.5

# Home A2A bearer token per agent (who is calling)
AGENT_TOKEN_DESKTOP=change-me-desktop
AGENT_TOKEN_SMARTPHONE=change-me-smartphone
AGENT_TOKEN_ROOT=change-me-root
AGENT_TOKEN_ROOM1=change-me-room1
AGENT_TOKEN_KITCHEN=change-me-kitchen
AGENT_TOKEN_ROOM2=change-me-room2
AGENT_TOKEN_PROBE=change-me-probe

# OpenClaw gateways (Control UI / CLI / scripts/say.sh auth)
OPENCLAW_GATEWAY_TOKEN=change-me-gateway

# Device Gateway (the virtual home's devices) and Event Collector, for agents run on the host
# (scripts/oc.sh). docker-compose.yml sets its own addresses inside Docker.
DEVICE_GATEWAY_URL=http://127.0.0.1:8100
EVENT_COLLECTOR_URL=http://127.0.0.1:8200

# Dashboards read device states (Gateway) and events (Collector) with this token.
DASHBOARD_TOKEN=change-me-dashboard

# Agent Hub and Studio (services/): the home admin's token for scripts and tests (people use the
# screens with Hub accounts: sign up at http://127.0.0.1:3000), Studio's token for registering agents
# in the Hub, and PostgreSQL (databases hub, studio, collector).
HOME_USER_TOKEN=change-me-home-user
STUDIO_TOKEN=change-me-studio
POSTGRES_PASSWORD=change-me-postgres
# The runtime asks the Hub which Hub-issued token is whose and who owns each device now (Gateway,
# Collector), and the Hub starts/stops Studio agents with it (scripts/launcher.mjs).
RUNTIME_TOKEN=change-me-runtime
# Studio fills its agent form with an LLM through LangChain (OPENROUTER_API_KEY above).
# STUDIO_LLM=rules uses the offline keyword filler instead (no key, no cost).
STUDIO_LLM=
STUDIO_MODEL=anthropic/claude-haiku-5.5
# Where generated agents run (services/studio/runtime.py). Only `openclaw` exists for now.
STUDIO_RUNTIME=openclaw
