{
  "id": "ambient-a2a",
  "name": "Ambient-A2A",
  "description": "Ambient-A2A smart-home extension over A2A v1.0 (context sharing, subscription, ownership, policy)",
  "categories": ["agent-orchestration"],
  "contracts": {
    "tools": ["ambient_status", "ambient_request", "ambient_publish", "ambient_control", "ambient_query", "ambient_home_energy_saving"]
  },
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "required": ["agentId", "role", "publicUrl", "peers", "tokens"],
    "properties": {
      "agentId": { "type": "string" },
      "role": { "enum": ["external", "home", "room"] },
      "publicUrl": { "type": "string" },
      "peers": { "type": "object" },
      "tokens": { "type": "object" },
      "gatewayUrl": { "type": "string" },
      "collectorUrl": { "type": "string" }
    },
    "additionalProperties": true
  }
}
