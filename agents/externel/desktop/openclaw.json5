// OpenClaw profile "desktop" — run via scripts/oc.sh desktop ...
{
  gateway: { $include: "../../gateway.json5", port: 18800 },
  agents: {
    defaults: {
      workspace: "${AMBIENT_HOME}/state/desktop/workspace",
      model: { primary: "${AMBIENT_MODEL:-openrouter/anthropic/claude-sonnet-5-5}" },
      thinkingDefault: "off", // tool routing needs no extended reasoning
      skipBootstrap: true, // no first-run SOUL/IDENTITY/BOOTSTRAP files in the prompt
    },
  },
  // Lean prompt: only Ambient-A2A tools, exposed directly (no tool_search indirection), no bundled skills.
  tools: { profile: "minimal", alsoAllow: ["ambient-a2a"], toolSearch: false },
  skills: { allowBundled: [] },
  plugins: {
    load: { paths: ["${AMBIENT_HOME}/app/agents/ambient-a2a-plugin"] },
    entries: {
      "ambient-a2a": {
        enabled: true,
        config: {
          $include: "../../shared.json5",
          agentId: "desktop",
          publicUrl: "http://127.0.0.1:18800/plugins/ambient",
          role: "external",
          subject: "user1",
          // Only these derived fields ever leave the desktop (no meeting titles, no screen content).
          provides: ["meeting_app_active", "pc_state"],
          fieldAcl: {
            room1: ["meeting_app_active", "pc_state"],
            orchestrator: ["meeting_app_active"],
          },
        },
      },
    },
  },
}
