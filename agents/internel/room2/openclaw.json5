// OpenClaw profile "room2" — run via scripts/oc.sh room2 ...
{
  gateway: { $include: "../../gateway.json5", port: 19280 },
  agents: {
    defaults: {
      workspace: "${AMBIENT_HOME}/state/room2/workspace",
      model: { primary: "${AMBIENT_MODEL:-openrouter/anthropic/claude-haiku-5.5}" },
      thinkingDefault: "off", // tool routing needs no extended reasoning
      skipBootstrap: true, // no first-run SOUL/IDENTITY/BOOTSTRAP files in the prompt
    },
  },
  // Lean prompt: only Ambient-A2A tools, exposed directly (no tool_search indirection), no bundled skills.
  tools: { profile: "minimal", alsoAllow: ["ambient-a2a"], toolSearch: false },
  skills: { allowBundled: [] },
  plugins: {
    load: { paths: ["${AMBIENT_HOME}/app/agents/ambient-a2a-plugin"] },
    entries: {
      "ambient-a2a": {
        enabled: true,
        config: {
          $include: "../../shared.json5",
          agentId: "room2",
          publicUrl: "http://127.0.0.1:19280/plugins/ambient",
          role: "room",
          space: "protected_room",
          owned: ["input_boolean.room2_light", "input_boolean.room2_ac", "input_boolean.room2_sleep_mode"],
          requestAcl: { orchestrator: ["*"] },
          // Safety rules apply to every requester, including Home.
          policies: [
            {
              when: { entity: "input_boolean.room2_sleep_mode", state: "on" },
              deny: { devices: ["input_boolean.room2_ac"], commands: ["TURN_OFF"] },
              reason_code: "SAFETY_POLICY",
              message: "Temperature regulation must remain enabled while sleeping.",
            },
            {
              when: { entity: "input_boolean.room2_sleep_mode", state: "on" },
              deny: { devices: ["input_boolean.room2_light"], commands: ["TURN_ON"] },
              reason_code: "SAFETY_POLICY",
              message: "Lights stay off while sleeping.",
            },
          ],
          energySaving: [
            { device: "input_boolean.room2_light", command: "TURN_OFF" },
            { device: "input_boolean.room2_ac", command: "TURN_OFF" },
          ],
        },
      },
    },
  },
}
