// OpenClaw profile "room1" — run via scripts/oc.sh room1 ...
{
  gateway: { $include: "../../gateway.json5", port: 19160 },
  agents: {
    defaults: {
      workspace: "${AMBIENT_HOME}/state/room1/workspace",
      model: { primary: "${AMBIENT_MODEL:-openrouter/anthropic/claude-sonnet-5-5}" },
    },
  },
  plugins: {
    load: { paths: ["${AMBIENT_HOME}/app/agents/ambient-a2a-plugin"] },
    entries: {
      "ambient-a2a": {
        enabled: true,
        config: {
          $include: "../../shared.json5",
          agentId: "room1",
          publicUrl: "http://127.0.0.1:19160/plugins/ambient",
          role: "room",
          space: "bedroom1",
          owned: [
            "input_boolean.room1_light", "input_select.room1_light_mode", "input_boolean.room1_ac", "input_boolean.room1_occupied",
            "input_boolean.bedroom1_curtain", "input_boolean.bedroom1_humidifier",
            "input_boolean.bedroom3_light", "input_boolean.bedroom3_air", "input_boolean.bedroom3_humidifier", "input_boolean.bedroom3_pc",
          ],
          requestAcl: { orchestrator: ["*"] },
          subscribeTo: { desktop: ["meeting_app_active", "pc_state"], smartphone: ["presence"] },
          rules: [
            { field: "meeting_app_active", equals: true, actions: [{ device: "input_select.room1_light_mode", command: "SET", value: "meeting" }] },
            { field: "meeting_app_active", equals: false, actions: [{ device: "input_select.room1_light_mode", command: "SET", value: "normal" }] },
            { field: "presence", equals: "AWAY", actions: [
              { device: "input_boolean.room1_light", command: "TURN_OFF" },
              { device: "input_boolean.room1_ac", command: "TURN_OFF" },
            ] },
          ],
          energySaving: [
            { device: "input_boolean.room1_light", command: "TURN_OFF" },
            { device: "input_boolean.room1_ac", command: "TURN_OFF" },
          ],
        },
      },
    },
  },
}
