{
  "id": "home-a2a",
  "name": "Home A2A",
  "description": "Smart-home agents over standard A2A v1.0 (context sharing, subscription, ownership, policy)",
  "categories": ["agent-orchestration"],
  "contracts": {
    "tools": ["a2a_status", "a2a_request", "a2a_publish", "a2a_control", "a2a_query", "a2a_home_energy_saving"]
  },
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "required": ["agentId", "role", "publicUrl", "peers", "tokens"],
    "properties": {
      "agentId": { "type": "string" },
      "role": { "enum": ["external", "home", "room"] },
      "publicUrl": { "type": "string" },
      "peers": { "type": "object" },
      "tokens": { "type": "object" },
      "token": { "type": "string" },
      "hubUrl": { "type": "string" },
      "gatewayUrl": { "type": "string" },
      "collectorUrl": { "type": "string" }
    },
    "additionalProperties": true
  }
}
