// Shared plugin settings merged into every agent's plugin config.
{
  peers: {
    desktop: "http://127.0.0.1:18800/plugins/a2a",
    smartphone: "http://127.0.0.1:18920/plugins/a2a",
    root: "http://127.0.0.1:19040/plugins/a2a",
    room1: "http://127.0.0.1:19160/plugins/a2a",
    room2: "http://127.0.0.1:19280/plugins/a2a",
    kitchen: "http://127.0.0.1:18680/plugins/a2a",
  },
  // ponytail: one bearer token per agent; switch to per-pair tokens/mTLS for mutually untrusted agents.
  tokens: {
    desktop: "${AGENT_TOKEN_DESKTOP}",
    smartphone: "${AGENT_TOKEN_SMARTPHONE}",
    root: "${AGENT_TOKEN_ROOT}",
    room1: "${AGENT_TOKEN_ROOM1}",
    room2: "${AGENT_TOKEN_ROOM2}",
    kitchen: "${AGENT_TOKEN_KITCHEN}",
    probe: "${AGENT_TOKEN_PROBE}",
  },
  // services/: the Device Gateway keeps the virtual home's devices (each agent calls it with its own
  // token, and it re-checks ownership); the Event Collector gathers every log line (empty = off).
  gatewayUrl: "${DEVICE_GATEWAY_URL:-http://127.0.0.1:8100}",
  // Agent Hub (empty = off): agents the user connected there (made in Studio) are found, verified
  // and allowed through it. Docker sets it to http://hub:8400.
  hubUrl: "${AGENT_HUB_URL:-}",
  collectorUrl: "${EVENT_COLLECTOR_URL:-}",
  logFile: "${AGENTS_ROOT}/logs/events.jsonl",
  ttlSec: 3600,
}
