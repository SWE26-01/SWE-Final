// Shared Ambient-A2A settings merged into every agent's plugin config.
{
  peers: {
    desktop: "http://127.0.0.1:18800/plugins/ambient",
    smartphone: "http://127.0.0.1:18920/plugins/ambient",
    orchestrator: "http://127.0.0.1:19040/plugins/ambient",
    room1: "http://127.0.0.1:19160/plugins/ambient",
    room2: "http://127.0.0.1:19280/plugins/ambient",
  },
  // ponytail: one bearer token per agent; switch to per-pair tokens/mTLS for mutually untrusted agents.
  tokens: {
    desktop: "${AMBIENT_TOKEN_DESKTOP}",
    smartphone: "${AMBIENT_TOKEN_SMARTPHONE}",
    orchestrator: "${AMBIENT_TOKEN_ORCHESTRATOR}",
    room1: "${AMBIENT_TOKEN_ROOM1}",
    room2: "${AMBIENT_TOKEN_ROOM2}",
    probe: "${AMBIENT_TOKEN_PROBE}",
  },
  ha: { url: "${HA_URL:-http://127.0.0.1:8123}", token: "${HA_TOKEN}" },
  // Optional (SWE-Final services/), empty = off. With a Device Gateway, HA calls go through it using
  // each agent's own token, and it re-checks device ownership; the Event Collector gathers every log line.
  gatewayUrl: "${AMBIENT_GATEWAY_URL:-}",
  collectorUrl: "${AMBIENT_COLLECTOR_URL:-}",
  logFile: "${AMBIENT_ROOT}/logs/events.jsonl",
  ttlSec: 3600,
}
