# Copy to .env.local (git-ignored). The token is DASHBOARD_TOKEN from the root .env (read-only).
VITE_DASHBOARD_TOKEN=
# Live Simulation runs need no setting here: the dev server reads SIMULATOR_TOKEN from the root .env
# and adds it on the /runner proxy, so it never reaches the browser. Keep `npm run dev` on localhost
# (the default): anyone who can reach the dev server can start runs.
# Optional: connect directly instead of through the dev-server proxy (needs AMBIENT_CORS_ORIGINS).
# Starting a run still needs the proxy.
# VITE_GATEWAY_URL=http://127.0.0.1:8100
# VITE_COLLECTOR_URL=http://127.0.0.1:8200
# VITE_RUNNER_URL=http://127.0.0.1:8300
