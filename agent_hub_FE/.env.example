# For `npm run dev` / `npm start` outside Docker (docker-compose.yml sets these for hub-web).
# Read on the server only (app/api/[service]/[...path]); the browser never sees them.
HUB_URL=http://127.0.0.1:8400
STUDIO_URL=http://127.0.0.1:8500
COLLECTOR_URL=http://127.0.0.1:8200
GATEWAY_URL=http://127.0.0.1:8100
# Copy from the root .env (people log in with Hub accounts; this one only reads the Collector/Gateway):
DASHBOARD_TOKEN=
# Set to true when the screen is served over https, so the session cookie is sent only there.
SESSION_COOKIE_SECURE=false
