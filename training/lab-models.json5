// Experiment-only models (DPO data collection and evaluation), served through training/proxy.py.
// Not referenced by the agent profiles in the repo: training/lab_agents.sh adds it to the runtime mirror only.
{
  mode: "merge",
  providers: {
    lab: {
      baseUrl: "http://127.0.0.1:8300/v1",
      apiKey: "lab",
      api: "openai-completions",
      models: [
        { id: "haiku", name: "Haiku 5.5 (lab proxy)", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 200000, maxTokens: 4096 },
        { id: "sonnet", name: "Sonnet 5.5 (lab proxy)", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 200000, maxTokens: 4096 },
        { id: "exaone", name: "EXAONE 4.0 1.2B base (local)", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32768, maxTokens: 2048 },
        { id: "exaone-dpo", name: "EXAONE 4.0 1.2B ambient DPO (local)", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32768, maxTokens: 2048 },
      ],
    },
  },
}
